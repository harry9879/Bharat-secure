<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Needed for the caller's number in the PHONE_STATE broadcast. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Speech model download, the online speech engine, and the laptop RAG
         server. The laptop server speaks plain http:// on the local hotspot,
         hence usesCleartextTraffic below. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ hides other apps unless declared: lets the menu open
         the team's SMS Shield (ScamShield) app. -->
    <queries>
        <package android:name="com.scamshield.sms" />
        <package android:name="com.scamshield.sms.debug" />
    </queries>

    <application
        android:name=".BharatSecureApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_shield"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Invisible activity opened from the notification button. Starting the
             microphone service from a visible activity satisfies Android 14+'s
             while-in-use rule for foreground microphone services. -->
        <activity
            android:name=".ProtectionLauncherActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".ProtectionService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".WhatsAppCallListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Keeps the microphone unmuted during calls; see CallAudioAccessibilityService. -->
        <service
            android:name=".CallAudioAccessibilityService"
            android:exported="true"
            android:label="BharatSecure call protection"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <receiver
            android:name=".CallStateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
