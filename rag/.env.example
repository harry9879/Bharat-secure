# Copy this file to .env (same folder) and paste your own keys after the "=".
# .env is ignored by git and never leaves this laptop.

# Speech-to-text: Whisper large-v3-turbo on Groq (https://console.groq.com -> API Keys)
GROQ_API_KEY=gsk_your_groq_key_here

# LLM judge: DeepSeek (https://platform.deepseek.com -> API keys)
DEEPSEEK_API_KEY=sk-your_deepseek_key_here
